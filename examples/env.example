# Copy to ../.env and customize
# Source with:   set -a; source .env; set +a

# --- What to scan ---
# Canonical UNC root of the share (preserved in every finding)
SHARE_UNC='\\fs01\data'
# SMB server + share (used for mount)
SMB_SERVER='fs01.corp.example.com'
SMB_SHARE='data'
# Credentials for read-only mount (use a dedicated scanning account)
SMB_USER='svc-discovery'
SMB_DOMAIN='CORP'
# SMB password is prompted at mount time; do not put it here.

# --- Where to put things on the analysis host ---
# Local read-only mount of the share
MOUNT='/mnt/share'
# Root for everything this playbook produces
ANALYSIS_ROOT='/analysis'
# Mirror tree for OCR output (same relative layout as source)
MIRROR="${ANALYSIS_ROOT}/ocr"
# Findings and logs
OUT="${ANALYSIS_ROOT}/out"
LOGS="${ANALYSIS_ROOT}/logs"

# --- Parallelism ---
# OCR and hashing jobs to run concurrently. Default: all cores.
JOBS=$(nproc 2>/dev/null || echo 4)

# --- Scan behavior ---
# TruffleHog verification (hits third-party APIs to confirm live keys).
# OFF by default. Require written client authorization before enabling.
TRUFFLEHOG_VERIFY='false'
# Path to custom TruffleHog detector YAML
TRUFFLEHOG_CONFIG='./config/trufflehog-custom.yaml'

# --- Presidio (optional PII depth) ---
# Set to 'true' to run Presidio NER-backed PII detection in step 04
ENABLE_PRESIDIO='true'
# Confidence threshold for Presidio findings to be recorded
PRESIDIO_MIN_SCORE='0.6'

# --- Crawl filters ---
# Glob patterns (semicolon-separated) to exclude from the manifest.
# Common system junk by default.
EXCLUDE_GLOBS='.DS_Store;Thumbs.db;*.tmp;~$*;desktop.ini'
# Maximum file size in MB to include (avoids multi-GB archives / VMs)
MAX_SIZE_MB='500'
